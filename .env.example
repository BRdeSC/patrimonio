# Patrimônio — variáveis de ambiente (COPIE para .env e ajuste; .env NUNCA é versionado)

# PostgreSQL
DATABASE_URL="postgresql://patrimonio:patrimonio@localhost:5432/patrimonio?schema=public"

# Sessão (qualquer string longa e aleatória — ex.: openssl rand -hex 32)
SESSION_SECRET="troque-por-um-segredo-longo-e-aleatorio"

# FreeIPA — mode: mock (dev/teste) | ldaps (produção). Default: mock.
IPA_MODE="mock"
IPA_LDAPS_URL="ldaps://ipa.exemplo.com.br:636"
IPA_BASE_DN="dc=exemplo,dc=com,dc=br"
# Conta de serviço p/ buscas, se aplicável (opcional — o bind é feito pelo próprio usuário)
IPA_BIND_DN=""
IPA_BIND_PASSWORD=""
# Caminho do arquivo de certificado CA da FreeIPA (verificação TLS)
IPA_CA_CERT="/run/secrets/ipa-ca.crt"

# URL pública do app (https:// em produção → cookie Secure)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
